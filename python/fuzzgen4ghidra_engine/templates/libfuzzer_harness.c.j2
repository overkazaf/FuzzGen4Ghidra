#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <dlfcn.h>
#include "types.h"
{% include "_resolve_target.c.j2" %}

typedef {{ return_type }} (*target_fn_t)({{ param_signature }});

static void *g_lib = NULL;
static target_fn_t g_target = NULL;

static int __attribute__((unused))
consume_bytes(const uint8_t *data, size_t data_len, size_t *offset, void *out, size_t n) {
    if (*offset + n > data_len) return -1;
    memcpy(out, data + *offset, n);
    *offset += n;
    return 0;
}

__attribute__((constructor))
static void fz_init_target(void) {
    g_lib = fz_open_target();
    if (!g_lib) {
        FZ_LOG("FATAL: target library could not be loaded - refusing to fuzz nothing");
        exit(2);
    }
{% if jni_mode != "off" or run_jni_onload %}
    fz_init_jni();
{% endif %}
    g_target = (target_fn_t)fz_resolve_target(g_lib);
    if (!g_target) {
        FZ_LOG("FATAL: target function %s could not be resolved", FZ_FUNC_NAME);
        exit(2);
    }
{% if run_jni_onload and jni_mode != "onload" %}
    fz_run_jni_onload(g_lib);
{% endif %}
}

int LLVMFuzzerTestOneInput(const uint8_t *_fz_input, size_t _fz_size) {
    if (!g_target) {
        FZ_LOG("FATAL: harness initialisation failed");
        abort();
    }

{% if jni_mode == "onload" %}
    /* JNI_OnLoad is a one-shot initialiser: run it once, not per input. */
    static int _fz_ran_onload = 0;
    if (_fz_ran_onload) return 0;
    _fz_ran_onload = 1;
{% endif %}
    const uint8_t *_fz_buf = _fz_input;
    size_t _fz_len = _fz_size;
    size_t _fz_off = 0;
    (void)_fz_buf; (void)_fz_len; (void)_fz_off;
{% for p in params %}
{{ p.deserialize_code }}
{% endfor %}

    g_target({{ call_args }});

{% for p in params %}
{{ p.cleanup_code }}
{% endfor %}
    return 0;
}
