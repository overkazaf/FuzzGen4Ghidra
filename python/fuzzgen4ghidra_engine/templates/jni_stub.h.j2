/*
 * Minimal fake JNI environment - generated by FuzzGen4Ghidra.
 *
 * Android native libraries expect a real JNIEnv from the ART runtime.  When
 * we call into the library from a plain native harness there is none, so we
 * synthesize a JNINativeInterface table:
 *
 *   - every slot is pre-filled with a no-op that returns 0/NULL
 *   - the handful of functions libraries actually need are implemented
 *     (GetVersion, FindClass, method/field IDs, strings, byte arrays,
 *      RegisterNatives, exceptions, GetJavaVM)
 *
 * This is deliberately permissive: unknown callbacks return 0 instead of
 * aborting, so the library keeps running and we reach deeper code.  A NULL
 * return may make the library bail out early - check the target's behaviour
 * if coverage stalls right after JNI_OnLoad.
 *
 * Layout note: JNINativeInterface is a pure aggregate of function pointers,
 * so filling it through a void** alias is safe on every ABI Android ships.
 * The named fields we care about are then overwritten one by one.
 */
#ifndef FUZZGEN_JNI_STUB_H
#define FUZZGEN_JNI_STUB_H

#include <jni.h>
#include <stdarg.h>
#include <stdint.h>
#include <string.h>

#define FZ_JNI_POOL_SLOTS 128
#define FZ_JNI_BUF_SIZE   4096

typedef struct {
    int            kind;   /* 1 = class, 2 = string, 3 = byte array, 4 = other */
    jsize          len;
    unsigned char *data;
} fz_jni_obj;

static fz_jni_obj     _fz_pool[FZ_JNI_POOL_SLOTS];
static unsigned char  _fz_pool_data[FZ_JNI_POOL_SLOTS][FZ_JNI_BUF_SIZE];
static int            _fz_pool_next = 0;
static fz_jni_obj     _fz_class_obj;
static int            _fz_ready = 0;
static jthrowable     _fz_pending_exception = NULL;
static fz_jni_obj     _fz_bounds_exception;

/* Check with subtraction so untrusted jsize values cannot overflow. */
static int fz_valid_region(jsize total, jsize start, jsize len) {
    if (start < 0 || len < 0 || start > total || len > total - start) {
        _fz_pending_exception = (jthrowable)&_fz_bounds_exception;
        return 0;
    }
    return 1;
}

static struct JNINativeInterface _fz_jni_iface;
static struct JNIInvokeInterface _fz_jvm_iface;

/* Native code receives JNIEnv* / JavaVM* - a pointer to these pointers. */
static const struct JNINativeInterface *_fz_jni_addr;
static const struct JNIInvokeInterface *_fz_jvm_addr;

static fz_jni_obj *fz_alloc_obj(int kind, jsize len) {
    int idx = _fz_pool_next++ % FZ_JNI_POOL_SLOTS;
    fz_jni_obj *o = &_fz_pool[idx];
    if (len < 0) len = 0;
    if (len > FZ_JNI_BUF_SIZE) len = FZ_JNI_BUF_SIZE;
    o->kind = kind;
    o->len  = len;
    o->data = _fz_pool_data[idx];
    return o;
}

static jint _fz_noop(void) { return 0; }

/* ---- implemented JNI callbacks ---- */

static jint JNICALL fz_GetVersion(JNIEnv *env) {
    (void)env;
    return JNI_VERSION_1_6;
}

static jclass JNICALL fz_FindClass(JNIEnv *env, const char *name) {
    (void)env; (void)name;
    return (jclass)&_fz_class_obj;
}

static jclass JNICALL fz_GetObjectClass(JNIEnv *env, jobject obj) {
    (void)env; (void)obj;
    return (jclass)&_fz_class_obj;
}

static jmethodID JNICALL fz_GetMethodID(JNIEnv *env, jclass cls, const char *name,
                                        const char *sig) {
    (void)env; (void)cls; (void)name; (void)sig;
    return (jmethodID)&_fz_class_obj; /* non-NULL keeps the library going */
}

static jmethodID JNICALL fz_GetStaticMethodID(JNIEnv *env, jclass cls, const char *name,
                                              const char *sig) {
    (void)env; (void)cls; (void)name; (void)sig;
    return (jmethodID)&_fz_class_obj;
}

static jfieldID JNICALL fz_GetFieldID(JNIEnv *env, jclass cls, const char *name,
                                      const char *sig) {
    (void)env; (void)cls; (void)name; (void)sig;
    return (jfieldID)&_fz_class_obj;
}

static jfieldID JNICALL fz_GetStaticFieldID(JNIEnv *env, jclass cls, const char *name,
                                            const char *sig) {
    (void)env; (void)cls; (void)name; (void)sig;
    return (jfieldID)&_fz_class_obj;
}

static jstring JNICALL fz_NewStringUTF(JNIEnv *env, const char *utf) {
    (void)env;
    if (!utf) return (jstring)fz_alloc_obj(2, 0);
    size_t n = strlen(utf);
    if (n >= FZ_JNI_BUF_SIZE) n = FZ_JNI_BUF_SIZE - 1;
    fz_jni_obj *o = fz_alloc_obj(2, (jsize)n);
    memcpy(o->data, utf, n);
    o->data[n] = '\0';
    return (jstring)o;
}

static jsize JNICALL fz_GetStringUTFLength(JNIEnv *env, jstring str) {
    (void)env;
    return str ? ((fz_jni_obj *)str)->len : 0;
}

static jsize JNICALL fz_GetStringLength(JNIEnv *env, jstring str) {
    (void)env;
    return str ? ((fz_jni_obj *)str)->len : 0;
}

static const char *JNICALL fz_GetStringUTFChars(JNIEnv *env, jstring str, jboolean *is_copy) {
    (void)env;
    if (is_copy) *is_copy = JNI_FALSE;
    if (!str) return "";
    return (const char *)((fz_jni_obj *)str)->data;
}

static void JNICALL fz_ReleaseStringUTFChars(JNIEnv *env, jstring str, const char *utf) {
    (void)env; (void)str; (void)utf;
}

static void JNICALL fz_GetStringUTFRegion(JNIEnv *env, jstring str, jsize start, jsize len,
                                         char *buf) {
    (void)env;
    if (!str) return;
    const fz_jni_obj *o = (const fz_jni_obj *)str;
    if (!fz_valid_region(o->len, start, len)) return;
    if (buf && len > 0) memcpy(buf, o->data + start, (size_t)len);
}

static jsize JNICALL fz_GetArrayLength(JNIEnv *env, jarray arr) {
    (void)env;
    if (!arr) return 0;
    return ((fz_jni_obj *)arr)->len;
}

static jbyteArray JNICALL fz_NewByteArray(JNIEnv *env, jsize len) {
    (void)env;
    return (jbyteArray)fz_alloc_obj(3, len);
}

static jbyte *JNICALL fz_GetByteArrayElements(JNIEnv *env, jbyteArray arr, jboolean *is_copy) {
    (void)env;
    if (is_copy) *is_copy = JNI_FALSE;
    if (!arr) return NULL;
    return (jbyte *)((fz_jni_obj *)arr)->data;
}

static void JNICALL fz_ReleaseByteArrayElements(JNIEnv *env, jbyteArray arr, jbyte *elems,
                                                jint mode) {
    (void)env; (void)arr; (void)elems; (void)mode;
}

static void JNICALL fz_SetByteArrayRegion(JNIEnv *env, jbyteArray arr, jsize start,
                                          jsize len, const jbyte *buf) {
    (void)env;
    if (!arr) return;
    fz_jni_obj *o = (fz_jni_obj *)arr;
    if (!fz_valid_region(o->len, start, len)) return;
    if (buf && len > 0) memcpy(o->data + start, buf, (size_t)len);
}

static void JNICALL fz_GetByteArrayRegion(JNIEnv *env, jbyteArray arr, jsize start,
                                          jsize len, jbyte *buf) {
    (void)env;
    if (!arr) return;
    const fz_jni_obj *o = (const fz_jni_obj *)arr;
    if (!fz_valid_region(o->len, start, len)) return;
    if (buf && len > 0) memcpy(buf, o->data + start, (size_t)len);
}

static jint JNICALL fz_RegisterNatives(JNIEnv *env, jclass cls,
                                       const JNINativeMethod *methods, jint n) {
    (void)env; (void)cls; (void)methods;
    /* Claim success; the library's JNI_OnLoad then returns JNI_VERSION. */
    return n < 0 ? -1 : 0;
}

static jthrowable JNICALL fz_ExceptionOccurred(JNIEnv *env) {
    (void)env;
    return _fz_pending_exception;
}

static jboolean JNICALL fz_ExceptionCheck(JNIEnv *env) {
    (void)env;
    return _fz_pending_exception ? JNI_TRUE : JNI_FALSE;
}

static void JNICALL fz_ExceptionDescribe(JNIEnv *env) { (void)env; }
static void JNICALL fz_ExceptionClear(JNIEnv *env) { (void)env; _fz_pending_exception = NULL; }

static jint JNICALL fz_Throw(JNIEnv *env, jthrowable obj) {
    (void)env;
    _fz_pending_exception = obj;
    return 0;
}

static jint JNICALL fz_ThrowNew(JNIEnv *env, jclass cls, const char *msg) {
    (void)env; (void)cls; (void)msg;
    _fz_pending_exception = (jthrowable)&_fz_bounds_exception;
    return 0;
}

static void JNICALL fz_FatalError(JNIEnv *env, const char *msg) {
    (void)env;
    (void)msg; /* never abort: a fatal JNI error should not stop fuzzing */
}

static jint JNICALL fz_GetJavaVM(JNIEnv *env, JavaVM **vm) {
    (void)env;
    if (vm) *vm = (JavaVM *)&_fz_jvm_addr;
    return JNI_OK;
}

static jobject JNICALL fz_NewObjectV(JNIEnv *env, jclass cls, jmethodID mid, va_list args) {
    (void)env; (void)cls; (void)mid; (void)args;
    return (jobject)fz_alloc_obj(4, 0);
}

static jobject JNICALL fz_NewObject(JNIEnv *env, jclass cls, jmethodID mid, ...) {
    (void)env; (void)cls; (void)mid;
    return (jobject)fz_alloc_obj(4, 0);
}

/* ---- JavaVM ---- */

static jint JNICALL fz_GetEnv(JavaVM *vm, void **env, jint version) {
    (void)vm; (void)version;
    if (env) *env = (void *)&_fz_jni_addr;
    return JNI_OK;
}

static jint JNICALL fz_AttachCurrentThread(JavaVM *vm, JNIEnv **env, void *args) {
    (void)vm; (void)args;
    if (env) *env = (JNIEnv *)&_fz_jni_addr;
    return JNI_OK;
}

static jint JNICALL fz_DetachCurrentThread(JavaVM *vm) {
    (void)vm;
    return JNI_OK;
}

static jint JNICALL fz_DestroyJavaVM(JavaVM *vm) {
    (void)vm;
    return JNI_OK;
}

static void fz_jni_ensure_init(void) {
    if (_fz_ready) return;
    _fz_ready = 1;

    _fz_jni_addr = &_fz_jni_iface;
    _fz_jvm_addr = &_fz_jvm_iface;

    _fz_class_obj.kind = 1;
    _fz_class_obj.len  = 0;
    _fz_class_obj.data = NULL;

    /* Fill every slot with the permissive no-op first. */
    {
        void **slots = (void **)&_fz_jni_iface;
        size_t n = sizeof(_fz_jni_iface) / sizeof(void *);
        size_t i;
        for (i = 0; i < n; i++) slots[i] = (void *)&_fz_noop;
    }

    _fz_jni_iface.GetVersion          = fz_GetVersion;
    _fz_jni_iface.FindClass           = fz_FindClass;
    _fz_jni_iface.GetObjectClass      = fz_GetObjectClass;
    _fz_jni_iface.GetMethodID         = fz_GetMethodID;
    _fz_jni_iface.GetStaticMethodID   = fz_GetStaticMethodID;
    _fz_jni_iface.GetFieldID          = fz_GetFieldID;
    _fz_jni_iface.GetStaticFieldID    = fz_GetStaticFieldID;
    _fz_jni_iface.NewStringUTF        = fz_NewStringUTF;
    _fz_jni_iface.GetStringUTFLength  = fz_GetStringUTFLength;
    _fz_jni_iface.GetStringLength     = fz_GetStringLength;
    _fz_jni_iface.GetStringUTFChars   = fz_GetStringUTFChars;
    _fz_jni_iface.ReleaseStringUTFChars = fz_ReleaseStringUTFChars;
    _fz_jni_iface.GetStringUTFRegion  = fz_GetStringUTFRegion;
    _fz_jni_iface.GetArrayLength      = fz_GetArrayLength;
    _fz_jni_iface.NewByteArray        = fz_NewByteArray;
    _fz_jni_iface.GetByteArrayElements = fz_GetByteArrayElements;
    _fz_jni_iface.ReleaseByteArrayElements = fz_ReleaseByteArrayElements;
    _fz_jni_iface.SetByteArrayRegion  = fz_SetByteArrayRegion;
    _fz_jni_iface.GetByteArrayRegion  = fz_GetByteArrayRegion;
    _fz_jni_iface.RegisterNatives     = fz_RegisterNatives;
    _fz_jni_iface.ExceptionOccurred   = fz_ExceptionOccurred;
    _fz_jni_iface.ExceptionCheck      = fz_ExceptionCheck;
    _fz_jni_iface.ExceptionDescribe   = fz_ExceptionDescribe;
    _fz_jni_iface.ExceptionClear      = fz_ExceptionClear;
    _fz_jni_iface.Throw               = fz_Throw;
    _fz_jni_iface.ThrowNew            = fz_ThrowNew;
    _fz_jni_iface.FatalError          = fz_FatalError;
    _fz_jni_iface.GetJavaVM           = fz_GetJavaVM;
    _fz_jni_iface.NewObjectV          = fz_NewObjectV;
    _fz_jni_iface.NewObject           = fz_NewObject;

    /* JavaVM: same trick, then the three slots ART actually calls. */
    {
        void **slots = (void **)&_fz_jvm_iface;
        size_t n = sizeof(_fz_jvm_iface) / sizeof(void *);
        size_t i;
        for (i = 0; i < n; i++) slots[i] = (void *)&_fz_noop;
    }
    _fz_jvm_iface.GetEnv              = fz_GetEnv;
    _fz_jvm_iface.AttachCurrentThread = fz_AttachCurrentThread;
    _fz_jvm_iface.DetachCurrentThread = fz_DetachCurrentThread;
    _fz_jvm_iface.DestroyJavaVM       = fz_DestroyJavaVM;
}

static JNIEnv fz_jni_env(void) {
    fz_jni_ensure_init();
    return (JNIEnv)_fz_jni_addr;
}

/* JNI_OnLoad takes a JavaVM*, not a JavaVM. */
static JavaVM *fz_jni_vm(void) {
    fz_jni_ensure_init();
    return (JavaVM *)&_fz_jvm_addr;
}

static jobject fz_jni_thiz(void) {
    fz_jni_ensure_init();
    return (jobject)&_fz_class_obj;
}

#endif /* FUZZGEN_JNI_STUB_H */
