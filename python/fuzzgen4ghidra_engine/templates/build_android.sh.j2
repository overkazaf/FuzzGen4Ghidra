#!/usr/bin/env bash
# Cross-compile the {{ func_name }} harness for Android ({{ android_abi }}).
# Generated by FuzzGen4Ghidra.
#
# Finds the NDK from ANDROID_NDK_HOME / ANDROID_NDK_ROOT / the default SDK
# location, then delegates to make.  Extra args are passed through, e.g.
#   ./build_android.sh API=23 -j4
set -euo pipefail

NDK="${ANDROID_NDK_HOME:-${ANDROID_NDK_ROOT:-}}"
if [ -z "$NDK" ]; then
    for base in "$HOME/Library/Android/sdk/ndk" "$HOME/Android/Sdk/ndk" \
                "/usr/local/lib/android/sdk/ndk"; do
        [ -d "$base" ] || continue
        while IFS= read -r candidate; do
            NDK="$candidate"
        done < <(find "$base" -maxdepth 1 -mindepth 1 -type d | sort -V)
    done
fi

if [ -z "$NDK" ] || [ ! -d "$NDK" ]; then
    echo "error: Android NDK not found; set ANDROID_NDK_HOME" >&2
    exit 1
fi

echo "NDK: $NDK"
make -C "$(dirname "$0")" NDK="$NDK" API={{ ndk_api }} TRIPLE={{ triple }} "$@"
