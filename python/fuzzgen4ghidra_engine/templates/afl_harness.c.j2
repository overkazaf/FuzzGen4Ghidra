typedef {{ return_type }} (*target_fn_t)({{ param_signature }});

static int __attribute__((unused))
consume_bytes(const uint8_t *data, size_t data_len, size_t *offset, void *out, size_t n) {
    if (*offset + n > data_len) return -1;
    memcpy(out, data + *offset, n);
    *offset += n;
    return 0;
}

int main(int argc, char **argv) {
    if (argc < 2) {
        fprintf(stderr, "Usage: %s <input_file>\n", argv[0]);
        return 1;
    }

    FILE *f = fopen(argv[1], "rb");
    if (!f) return 1;
    fseek(f, 0, SEEK_END);
    long file_len = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (file_len <= 0) { fclose(f); return 1; }

    size_t _fz_len = (size_t)file_len;
    uint8_t *_fz_buf = (uint8_t *)malloc(_fz_len);
    if (!_fz_buf) { fclose(f); return 1; }
    fread(_fz_buf, 1, _fz_len, f);
    fclose(f);

    void *lib = fz_open_target();
    if (!lib) {
        FZ_LOG("FATAL: target library could not be loaded - refusing to fuzz nothing");
        free(_fz_buf);
        return 2;
    }
{% if jni_mode != "off" or run_jni_onload %}
    fz_init_jni();
{% endif %}
    target_fn_t target = (target_fn_t)fz_resolve_target(lib);
    if (!target) {
        FZ_LOG("FATAL: target function %s could not be resolved", FZ_FUNC_NAME);
        free(_fz_buf);
        return 2;
    }
{% if run_jni_onload and jni_mode != "onload" %}
    fz_run_jni_onload(lib);
{% endif %}

    size_t _fz_off = 0;
    (void)_fz_buf; (void)_fz_len; (void)_fz_off;
{% for p in params %}
{{ p.deserialize_code }}
{% endfor %}

    target({{ call_args }});

{% for p in params %}
{{ p.cleanup_code }}
{% endfor %}
    free(_fz_buf);
    return 0;
}
