/*
 * Target module resolution - generated by FuzzGen4Ghidra.
 *
 * A prebuilt shared library often exports only a handful of symbols (JNI
 * entry points), so the function we want to fuzz usually has no dynamic
 * symbol and dlsym() cannot find it.  This partial loads the module and
 * resolves the function two ways:
 *
 *   1. dlsym(handle, name)                      - works for exported symbols
 *   2. load_bias + ELF virtual address          - works for local symbols
 *
 * The load bias is recovered from an exported anchor symbol (JNI_OnLoad),
 * falling back to dl_iterate_phdr() matching the module's basename.
 *
 * Every failure is fatal and loud: a harness that silently returns without
 * calling into the target fuzzes nothing and reports a false "no crashes".
 */
#ifndef FUZZGEN_RESOLVE_TARGET_C
#define FUZZGEN_RESOLVE_TARGET_C

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>

#if defined(__ANDROID__) || defined(__linux__)
#  include <link.h>
#endif

{% if jni_mode != "off" or run_jni_onload %}
#include "jni_stub.h"
{% endif %}

#define FZ_FUNC_NAME    "{{ func_name }}"
#define FZ_FUNC_VADDR   ((uintptr_t){{ func_vaddr_hex }})
#define FZ_ANCHOR_NAME  "{{ anchor_symbol }}"
#define FZ_ANCHOR_VADDR ((uintptr_t){{ anchor_vaddr_hex }})
#define FZ_CALL_MODE    "{{ call_mode }}"
#define FZ_DEFAULT_PATH "./{{ target_binary }}"

#define FZ_LOG(...) \
    do { \
        fprintf(stderr, "[fuzzgen] " __VA_ARGS__); \
        fputc('\n', stderr); \
        fflush(stderr); \
    } while (0)

static const char *fz_target_path(void) {
    const char *env = getenv("FUZZGEN_TARGET");
    if (env && *env) return env;
    return FZ_DEFAULT_PATH;
}

static const char *__attribute__((unused)) fz_basename(const char *path) {
    const char *slash = strrchr(path, '/');
    return slash ? slash + 1 : path;
}

#if defined(__ANDROID__) || defined(__linux__)
struct fz_phdr_ctx {
    const char *want;
    uintptr_t   base;
};

static int fz_phdr_cb(struct dl_phdr_info *info, size_t size, void *data) {
    struct fz_phdr_ctx *ctx = (struct fz_phdr_ctx *)data;
    (void)size;
    if (!info->dlpi_name || !*info->dlpi_name) return 0;
    if (strcmp(fz_basename(info->dlpi_name), ctx->want) == 0) {
        ctx->base = (uintptr_t)info->dlpi_addr;
        return 1; /* stop iteration */
    }
    return 0;
}
#endif

/* Recover the ELF load bias (the value that turns an st_value into a
 * runtime address). */
static uintptr_t fz_load_bias(void *handle) {
    if (FZ_ANCHOR_NAME[0] != '\0') {
        void *anchor = dlsym(handle, FZ_ANCHOR_NAME);
        if (anchor) {
            if (FZ_ANCHOR_VADDR != 0) {
                uintptr_t bias = (uintptr_t)anchor - FZ_ANCHOR_VADDR;
                FZ_LOG("anchor %s @ %p (vaddr %p) -> load bias %p",
                       FZ_ANCHOR_NAME, anchor, (void *)FZ_ANCHOR_VADDR, (void *)bias);
                return bias;
            }
            Dl_info di;
            memset(&di, 0, sizeof(di));
            if (dladdr(anchor, &di) && di.dli_fbase) {
                FZ_LOG("anchor %s @ %p -> dladdr base %p",
                       FZ_ANCHOR_NAME, anchor, di.dli_fbase);
                return (uintptr_t)di.dli_fbase;
            }
        } else {
            FZ_LOG("anchor %s is not exported", FZ_ANCHOR_NAME);
        }
    }

#if defined(__ANDROID__) || defined(__linux__)
    {
        struct fz_phdr_ctx ctx;
        ctx.want = fz_basename(fz_target_path());
        ctx.base = 0;
        dl_iterate_phdr(fz_phdr_cb, &ctx);
        if (ctx.base) {
            FZ_LOG("dl_iterate_phdr found %s -> load bias %p",
                   ctx.want, (void *)ctx.base);
            return ctx.base;
        }
    }
#endif
    return 0;
}

static void *fz_resolve_target(void *handle) {
    int allow_symbol = (strcmp(FZ_CALL_MODE, "address") != 0);
    int allow_address = (strcmp(FZ_CALL_MODE, "dlsym") != 0);

    if (allow_symbol) {
        dlerror(); /* clear */
        void *sym = dlsym(handle, FZ_FUNC_NAME);
        if (sym) {
            FZ_LOG("resolved %s via dlsym -> %p", FZ_FUNC_NAME, sym);
            return sym;
        }
        const char *err = dlerror();
        FZ_LOG("dlsym(%s) failed: %s", FZ_FUNC_NAME, err ? err : "unknown error");
        if (!allow_address) {
            FZ_LOG("FATAL: %s is not exported and call_mode=dlsym", FZ_FUNC_NAME);
            return NULL;
        }
    }

    if (FZ_FUNC_VADDR == 0) {
        FZ_LOG("FATAL: no ELF virtual address recorded for %s", FZ_FUNC_NAME);
        return NULL;
    }

    uintptr_t bias = fz_load_bias(handle);
    if (!bias) {
        FZ_LOG("FATAL: could not determine the load bias of %s", fz_target_path());
        return NULL;
    }

    void *addr = (void *)(bias + FZ_FUNC_VADDR);
    FZ_LOG("resolved %s via load_bias %p + vaddr %p -> %p",
           FZ_FUNC_NAME, (void *)bias, (void *)FZ_FUNC_VADDR, addr);
    return addr;
}

/* Load the target module. Returns NULL after printing a diagnosis. */
static void *fz_open_target(void) {
    const char *path = fz_target_path();
    void *handle = dlopen(path, RTLD_NOW | RTLD_GLOBAL);
    if (!handle) {
        const char *err = dlerror();
        FZ_LOG("dlopen(\"%s\", RTLD_NOW) failed: %s", path, err ? err : "unknown");
        FZ_LOG("retrying with RTLD_LAZY");
        handle = dlopen(path, RTLD_LAZY | RTLD_GLOBAL);
    }
    if (!handle) {
        const char *err = dlerror();
        FZ_LOG("FATAL: dlopen(\"%s\") failed: %s", path, err ? err : "unknown");
        FZ_LOG("Hints: FUZZGEN_TARGET=/absolute/path/to/{{ target_binary }}; "
               "put missing dependencies next to it or in LD_LIBRARY_PATH.");
        return NULL;
    }
    FZ_LOG("loaded %s (handle %p)", path, handle);
    return handle;
}

{% if jni_mode != "off" or run_jni_onload %}
static JNIEnv  __attribute__((unused)) _fz_env;
static jobject __attribute__((unused)) _fz_thiz;

static void fz_init_jni(void) {
    _fz_env  = fz_jni_env();
    _fz_thiz = fz_jni_thiz();
}
{% endif %}

{% if run_jni_onload and jni_mode != "onload" %}
/* Run JNI_OnLoad first so RegisterNatives()/global init happen. */
static void fz_run_jni_onload(void *handle) {
    void *sym = dlsym(handle, "JNI_OnLoad");
    if (!sym) {
        FZ_LOG("JNI_OnLoad not exported; skipping pre-initialisation");
        return;
    }
    jint (*onload)(JavaVM *, void *) = (jint (*)(JavaVM *, void *))sym;
    jint version = onload(fz_jni_vm(), NULL);
    FZ_LOG("JNI_OnLoad returned 0x%x", (unsigned)version);
}
{% endif %}

#endif /* FUZZGEN_RESOLVE_TARGET_C */
