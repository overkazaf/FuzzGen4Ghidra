#!/usr/bin/env bash
# Push and run the {{ func_name }} harness on an attached Android device.
# Generated by FuzzGen4Ghidra.
#
#   adb devices                       # make sure exactly one device is attached
#   ./run_on_device.sh                # push + run
#   FUZZGEN_TARGET=/abs/lib.so ./run_on_device.sh
#
# The device ABI must be {{ android_abi }}; the script refuses otherwise.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
HARNESS="harness_{{ func_name }}"
TARGET="${FUZZGEN_TARGET:-$HERE/{{ target_binary }}}"
WORKDIR="/data/local/tmp/fuzzgen_{{ func_name }}"

if [ ! -f "$HERE/$HARNESS" ]; then
    echo "error: $HARNESS not found - run ./build_android.sh first" >&2
    exit 1
fi
if [ ! -f "$TARGET" ]; then
    echo "error: target library not found: $TARGET" >&2
    exit 1
fi

ABI="$(adb shell getprop ro.product.cpu.abi | tr -d '\r')"
echo "device ABI: $ABI (expected {{ android_abi }})"
case "$ABI" in
    {{ android_abi }}*) ;;
    *) echo "error: ABI mismatch - rebuild for $ABI" >&2; exit 1 ;;
esac

adb shell "mkdir -p '$WORKDIR/corpus'"
adb push "$TARGET" "$WORKDIR/{{ target_binary }}"

# A target .so usually lists sibling libraries in DT_NEEDED (libttffmpeg.so,
# libc++_shared.so, ...). dlopen() fails outright when one is missing, so push
# any .so that sits next to the harness or next to the target.
SEEN=("{{ target_binary }}")
TARGET_DIR="$(cd "$(dirname "$TARGET")" && pwd)"
for f in "$HERE"/*.so "$TARGET_DIR"/*.so; do
    [ -f "$f" ] || continue
    b="$(basename "$f")"
    already_seen=false
    for seen in "${SEEN[@]}"; do
        if [ "$seen" = "$b" ]; then already_seen=true; break; fi
    done
    if "$already_seen"; then continue; fi
    SEEN+=("$b")
    echo "pushing dependency: $b"
    adb push "$f" "$WORKDIR/$b"
done

adb push "$HERE/$HARNESS" "$WORKDIR/$HARNESS"
if [ -d "$HERE/seeds" ]; then
    adb push "$HERE/seeds/." "$WORKDIR/corpus/"
fi

adb shell "chmod 755 '$WORKDIR/$HARNESS'"

{% if fmt == "libfuzzer" %}
adb shell "cd '$WORKDIR' && \
    FUZZGEN_TARGET='./{{ target_binary }}' \
    LD_LIBRARY_PATH='$WORKDIR' \
    ASAN_OPTIONS='detect_leaks=0:abort_on_error=0' \
    ./$HARNESS corpus/ -max_len=4096 -rss_limit_mb=4096"
{% else %}
SEED="$(ls "$HERE"/seeds/* 2>/dev/null | head -n 1 || true)"
if [ -z "$SEED" ]; then
    head -c 256 /dev/urandom > "$HERE/seeds_seed_000.tmp"
    SEED="$HERE/seeds_seed_000.tmp"
fi
adb push "$SEED" "$WORKDIR/input.bin"
adb shell "cd '$WORKDIR' && \
    FUZZGEN_TARGET='./{{ target_binary }}' \
    LD_LIBRARY_PATH='$WORKDIR' \
    ASAN_OPTIONS='detect_leaks=0' \
    ./$HARNESS input.bin"
{% endif %}
